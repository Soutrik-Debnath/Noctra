.DS_Store
node_modules
/build
/.svelte-kit
/package
.env
.env.*
!.env.example
vite.config.js.timestamp-*
vite.config.ts.timestamp-*

# Rust build cache - regenerates with `npm run tauri dev`, reached 12 GB here.
src-tauri/target

# Vite output, regenerated by `npm run build`.
/dist

# Subagent-driven-development scratch for whichever plan is currently executing.
/.superpowers/

# Generated by scripts/tauri.mjs on `npm run tauri dev`: the base config plus the Chrome debugging
# port the probe harness needs. Regenerated every dev run, and it must never reach a release build.
src-tauri/tauri.dev.json

# Throwaway visual-probe scratch: extracted reference-video frames, contact sheets and one-off
# capture PNGs. Left on disk on purpose, just not worth permanent history.
/frames*/
/sheet-*.png
/x-*.png
/*.mp4
/scripts/*.png
/scripts/*-elements.json
/scripts/audit-*.json
# sweep-views.mjs writes the generated per-step expression to disk so cdp-eval can take it via --file,
# and removes it in a finally. Only survives a crash — but it is generated source, never an artefact.
/scripts/.sweep-generated-*.mjs

# Manual pre-edit snapshots taken while this folder had no version control. They are the only revert
# path for work done before the first commit, so they stay on disk — but git supersedes them from here
# on, and tracking 12-file copies of the same module would only make future diffs noisy.
/backups/
/_backup-*/
/bar*.png
# Probe captures dropped at the repo root by whatever session is measuring motion or the window
# chrome right now (`m-hover.png`, `m2-rest.png`, `wm-final-crop.png`, ...). Wildcarded rather than
# listed one by one, because they keep arriving faster than this file gets updated and each one is
# a few hundred KB of screenshot in a repo that is going to be public.
/m*.png
/wm*.png

# Design research: screenshots and recordings of OTHER apps. Kept on disk for
# reference, never published — they are not ours to redistribute.
docs/references/
